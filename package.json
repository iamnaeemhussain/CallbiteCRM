{
  "name": "callbite-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "worker:dev": "wrangler dev --ip 0.0.0.0 --port 3000",
    "worker:deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 execute callbite-crm --local --file=migrations/0001_initial_schema.sql && wrangler d1 execute callbite-crm --local --file=migrations/0002_seed_data.sql",
    "d1:migrate:prod": "wrangler d1 execute callbite-crm --remote --file=migrations/0001_initial_schema.sql && wrangler d1 execute callbite-crm --remote --file=migrations/0002_seed_data.sql"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hono": "^4.7.4",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^3.99.0"
  }
}
